{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "android: assembleRelease (arm64-v8a)",
      "type": "shell",
      "command": "./gradlew.bat assembleRelease",
      "options": {
        "cwd": "${workspaceFolder}/android",
        "env": {
          "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
        }
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Release APK for the phone. Output: android/app/build/outputs/apk/release/"
    }
  ]
}